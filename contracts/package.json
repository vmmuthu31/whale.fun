{
  "name": "contracts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts",
    "deploy:local": "tsx scripts/deploy-testnet.ts",
    "deploy:sepolia": "tsx scripts/deploy-testnet.ts",
    "deploy:full": "tsx scripts/deploy/deploy-full.ts --network 0g-testnet",
    "verify": "echo 'Use block explorer API or custom verify flow (not configured yet)' && exit 0",
    "roundrobin:create-tokens": "tsx scripts/roundrobin-create-tokens.ts",
    "roundrobin:testnet": "tsx scripts/roundrobin-create-tokens.ts --network 0g-testnet --count 1",
    "roundrobin:testnet:simulate": "tsx scripts/roundrobin-create-tokens.ts --network 0g-testnet --count 1 --simulate",
    "roundrobin:local": "tsx scripts/roundrobin-create-tokens.ts --network localhost --count 1",
    "roundrobin:local:simulate": "tsx scripts/roundrobin-create-tokens.ts --network localhost --count 1 --simulate",
    "generate:addresses": "tsx scripts/utils/generate-addresses.ts",
    "integration:testnet": "tsx scripts/integration-e2e.ts --network 0g-testnet",
    "integration:testnet:simulate": "tsx scripts/integration-e2e.ts --network 0g-testnet --simulate",
    "roundrobin:trade:testnet": "tsx scripts/roundrobin-trade.ts --network 0g-testnet --actionsMin 20 --actionsMax 30",
    "roundrobin:trade:testnet:simulate": "tsx scripts/roundrobin-trade.ts --network 0g-testnet --actionsMin 20 --actionsMax 30 --simulate",
    "typecheck:scripts": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@types/node": "^22.18.6",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.0.6",
    "tsx": "^4.19.1",
    "typescript": "~5.8.0",
    "viem": "^2.37.8"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.2.2",
    "solady": "^0.1.26"
  }
}
