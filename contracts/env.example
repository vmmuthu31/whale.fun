# Copy this to .env (do not commit .env)
# Root deployer private key (0x-prefixed hex, no quotes)
ROOT_PRIVATE_KEY=
# Optional: legacy variable name supported by config
PRIVATE_KEY=

# RPC endpoints
RPC_LOCALHOST=http://127.0.0.1:8545
RPC_0G_TESTNET=https://evmrpc-testnet.0g.ai
RPC_0G_MAINNET=https://evmrpc.0g.ai

# Network IDs
CHAIN_ID_LOCAL=31337
CHAIN_ID_0G_TESTNET=16602
CHAIN_ID_0G_MAINNET=16661

# Round-robin funding and token creation (used later by scripts)
# Comma-separated list of 0x-private keys for secondary wallets
SECONDARY_PRIVATE_KEYS=
# Amount of native token to fund each secondary wallet (in wei)
FUND_PER_WALLET_WEI=
# Default token params (optional; scripts will have flags too)
DEFAULT_TOKEN_NAME=
DEFAULT_TOKEN_SYMBOL=
DEFAULT_TOKEN_SUPPLY=
DEFAULT_TARGET_MARKET_CAP=
DEFAULT_CREATOR_FEE_BPS=
DEFAULT_DESCRIPTION=
DEFAULT_LOGO_URL=
DEFAULT_COMMUNITY_SIZE=
DEFAULT_LIQUIDITY_DEPTH_WEI=

# Safety
# Require explicit confirmation for non-local actions (true/false)
CONFIRM=
